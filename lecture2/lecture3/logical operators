x = 10
y = 20 
z = 30
#using 'and' operators
if x < y and y < z:
    print("x is less than y and y is less than z.") #true
#using 'or' operators
if x < y or y > z:
    print("Either x is less than y or y is greater than z.") #true
#using 'not' operators
if not (x > y):
    print("x is not greater than y.") #true